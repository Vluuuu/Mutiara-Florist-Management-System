/backups/
/backup/
/database/dumps/
/database/backups/
/private-data/
/local-data/
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.bak
*.backup
*.7z
*.zip
*.enc

# User uploads / payment receipts
/storage/app/private/
/storage/app/public/uploads/
/public/storage

# Avoid committing generated artifacts by default
/coverage/
