# ==============================================================================
# MFMS Phase 14B Same-Domain Edge Router Template (nginx:1.27-alpine)
# Mounted at /etc/nginx/templates/default.conf.template
#
# Environment variables substituted at container start (Nginx official envsubst):
#   MFMS_PRIMARY_UPSTREAM : e.g. mfms-staging-app:10000 or mfms-production-app:10000
#   MFMS_DEMO_UPSTREAM    : e.g. mfms-staging-demo:10000 or mfms-production-demo:10000
#   MFMS_SERVER_NAMES     : e.g. staging-admin.mutiaraflorist.id or admin.mutiaraflorist.id
#
# Security & Compatibility Invariants:
# 1. Defaults ALL requests to the primary runtime unless an explicit demo routing
#    cookie (mfms_runtime=demo) or /demo path is selected. Works identically with
#    CLOUDFLARE_ACCESS_ENFORCE=true (staging) and CLOUDFLARE_ACCESS_ENFORCE=false
#    (production) without requiring Cloudflare policy changes.
# 2. mfms_runtime=demo is strictly a runtime selector, NEVER an auth token.
#    Both runtimes enforce independent APP_KEYs, session cookies, databases, and
#    server-side authentication.
# 3. Preserves upstream X-Forwarded-Proto (https from Cloudflare Tunnel) so
#    Laravel redirects, signed/secure cookies, and Inertia URLs stay HTTPS.
# 4. Strips Cf-Access-Jwt-Assertion and X-MFMS-Edge-Secret before proxying to
#    the demo runtime.
# 5. Uses Docker embedded DNS resolver (127.0.0.11) so stopping/restarting one
#    runtime container never breaks or stalls the other.
# 6. Dynamic/authenticated/financial responses are NEVER cached by the router.
# ==============================================================================

limit_req_zone $binary_remote_addr zone=mfms_login:5m rate=10r/m;
limit_req_zone $binary_remote_addr zone=mfms_general:10m rate=60r/m;

map $cookie_mfms_runtime $mfms_upstream {
    "demo"  "${MFMS_DEMO_UPSTREAM}";
    default "${MFMS_PRIMARY_UPSTREAM}";
}

# Preserve HTTPS scheme from Cloudflare Tunnel / upstream proxy; fallback to local $scheme
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Never forward Cloudflare Zero Trust assertion headers or edge secrets to demo runtime
map $mfms_upstream $forwarded_cf_jwt {
    "${MFMS_PRIMARY_UPSTREAM}" $http_cf_access_jwt_assertion;
    default                    "";
}

map $mfms_upstream $forwarded_edge_secret {
    "${MFMS_PRIMARY_UPSTREAM}" $http_x_mfms_edge_secret;
    default                    "";
}

server {
    listen 10000 default_server;
    listen [::]:10000 default_server;
    server_name ${MFMS_SERVER_NAMES} _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 2m;

    # Router liveness check
    location = /up {
        access_log off;
        add_header Content-Type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # Content-hashed Vite static assets (identical across both containers, zero sensitive data)
    location ^~ /build/ {
        proxy_pass http://$mfms_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cf-Access-Jwt-Assertion $forwarded_cf_jwt;
        proxy_set_header X-MFMS-Edge-Secret $forwarded_edge_secret;
    }

    # Explicit return to primary admin runtime -> ALWAYS primary runtime (clears demo routing cookie)
    location = /admin-entry {
        set $primary_target "${MFMS_PRIMARY_UPSTREAM}";
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_pass http://$primary_target;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # Explicit entry into isolated demo runtime -> ALWAYS demo runtime (strips CF headers)
    location = /demo {
        set $demo_target "${MFMS_DEMO_UPSTREAM}";
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_pass http://$demo_target;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header X-MFMS-Edge-Secret "";
    }

    # Rate-limited login endpoint
    location = /login {
        limit_req zone=mfms_login burst=10 nodelay;
        limit_req_status 429;
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        proxy_pass http://$mfms_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cf-Access-Jwt-Assertion $forwarded_cf_jwt;
        proxy_set_header X-MFMS-Edge-Secret $forwarded_edge_secret;
    }

    # All dynamic application routes (zero shared proxy caching)
    location / {
        limit_req zone=mfms_general burst=40 nodelay;
        limit_req_status 429;
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        proxy_pass http://$mfms_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cf-Access-Jwt-Assertion $forwarded_cf_jwt;
        proxy_set_header X-MFMS-Edge-Secret $forwarded_edge_secret;
    }
}
