# ==============================================================================
# MFMS Isolated Temporary Demo Runtime Environment Template
# Store the real copy outside Git (e.g. /etc/mfms/demo.env with chmod 600).
#
# SECURITY: NEVER place production PostgreSQL credentials, production APP_KEY,
# or BACKUP_ENCRYPTION_KEY in this file. The container refuses to boot if any
# production database/backup secret is present.
# ==============================================================================

APP_NAME="Mutiara Florist Management System"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_DEDICATED_DEMO_APP_KEY
APP_DEBUG=false
APP_URL=https://admin.mutiaraflorist.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=10
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Strictly isolated local SQLite (NO DB_HOST, NO DB_PASSWORD, NO DB_URL)
MFMS_RUNTIME_MODE=demo
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/mfms-demo/demo.sqlite
DB_FOREIGN_KEYS=true

# Isolated server-side file sessions & cache (distinct cookie name from prod)
SESSION_DRIVER=file
SESSION_COOKIE=mfms_demo_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Demo Access Lifecycle (14-day window from production activation)
DEMO_ENABLED=true
DEMO_EMAIL=demo@mutiaraflorist.id
DEMO_PASSWORD=REPLACE_WITH_GENERATED_DEMO_PASSWORD
DEMO_DISPLAY_NAME="Evaluator Demo"
# Set ISO-8601 WIB activation timestamp when activating demo in production:
DEMO_ACTIVATED_AT=2026-11-25T00:00:00+07:00
DEMO_DURATION_DAYS=14
DEMO_RESET_TIME=03:00
DEMO_FLUSH_SESSIONS_ON_RESET=true

# Demo Safety Quotas
DEMO_MAX_CUSTOMERS=250
DEMO_MAX_ORDERS=250
DEMO_MAX_EXPENSES=500

# Demo runtime does not enforce admin Cloudflare Access OTP JWT
CLOUDFLARE_ACCESS_ENFORCE=false
